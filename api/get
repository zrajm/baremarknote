#
# URL handling is (intentionally) naïve. URL encoded strings are not decoded.
# (The only parameter allowed is 'id', and its value MUST be an 11 char
# url-safe base64 encoded value.) This naïveté should be fixed before using
# this software in a serious manner.
#
set -eu
CDPATH=''

out() { printf '%s\r\n' "$@"; }
die() {
    out 'HTTP/1.1 400 Bad Request' \
        'Content-Type: application/json; charset=utf-8' \
        '' \
        '{"code":400,"msg":"'"$*"'"}'
    exit 0
}

# Split $QUERY_STRING into $@. Params may also be passed on the command line as
# 'KEY=VALUE'.
OLDIFS="$IFS"; IFS='&'
[ -n "$QUERY_STRING" ] && set -- $QUERY_STRING # intentionally unquoted
IFS="$OLDIFS"

out 'HTTP/1.1 200 OK' \
    'Content-Type: text/plain; charset=utf-8' \
    ''

for PARAM; do
    NAME="${PARAM%%=*}"
    VALUE="${PARAM#*=}"
    # Parameter names MUST be lower case letters only.
    case "$NAME" in *[!a-zA-Z0-9_-]*) die "Invalid parameter name '$NAME'"; esac
    # Parameter value MUST be lower case letters only.
    case "$NAME" in *[!a-zA-Z0-9_-]*) die "Invalid parameter value '$VALUE'"; esac
    eval "_$NAME=$VALUE"
done

clean_exit() {
    STATUS="$?"
    if [ "$STATUS" -ne 0 ]; then
        out 'HTTP/1.1 500 Internal Server Error' \
            'Content-Type: application/json; charset=utf-8' \
            '' \
            '{"code":400,"msg":"Internal Server Error"}'
    fi
    exit "$STATUS"
}

trap clean_exit EXIT

# Change dir to that of script.
case "$0" in */*) cd "${0%/*}"; esac
cd ../data

if ! [ -e "$_id" ]; then die "Unknown note '$_id'"; fi

cat "$_id"

exit 0

#EOF
