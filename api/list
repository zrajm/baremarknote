#
# URL handling is (intentionally) naïve. URL encoded strings are not decoded.
# (The only parameter allowed is 'id', and its value MUST be an 11 char
# url-safe base64 encoded value.) This naïveté should be fixed before using
# this software in a serious manner.
#
set -eu
CDPATH=''

out() { printf '%s\r\n' "$@"; }

clean_exit() {
    STATUS="$?"
    if [ "$STATUS" -ne 0 ]; then
        out 'HTTP/1.1 500 Internal Server Error' \
            'Content-Type: application/json; charset=utf-8' \
            '' \
            '{"code":500,"msg":"Internal Server Error"}'
    fi
    exit "$STATUS"
}

trap clean_exit EXIT

# Change dir to that of script.
case "$0" in */*) cd "${0%/*}"; esac
cd ../data

BODY=''
set -- *

if [ "$#" -eq 1 ] && [ "$1" = '*' ]; then
    :
else
    while read -r EPOCH FILE; do
        case "$FILE" in *[!a-zA-Z0-9_-]*) continue; esac
        [ -n "$BODY" ] && BODY="$BODY,"
        BODY="$BODY{\"id\":\"$FILE\",\"updated\":$EPOCH}"
    done <<-EOF
	$(stat -c '%Y %n' "$@" | sort -nrk1,1)
	EOF
fi

out 'HTTP/1.1 200 OK' \
    'Content-Type: application/json; charset=utf-8' \
    '' \
    "{\"list\":[$BODY]}"

exit 0

#EOF
